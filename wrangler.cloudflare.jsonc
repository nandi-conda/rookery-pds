{
  // roost on Cloudflare Workers, at https://roost.latha.org with handles
  // under .agent.latha.org. rookery.latha.org, the old hostname, stays routed
  // here so agents and DID documents that still name it keep working. Deploy with `pixi run cf-deploy` (operator only,
  // see docs/cloudflare.md). wrangler creates the D1 database and R2 bucket by
  // name on the first deploy, so neither needs an id here.
  "name": "rookery-pds",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  // Static files served by the runtime before the Worker runs: the dashboard
  // at /dashboard/ (built from dashboard/app.py). Nothing at public/ root, so
  // "/" stays the Worker's landing page.
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "roost.latha.org", "custom_domain": true },
    { "pattern": "rookery.latha.org", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "AccountDurableObject" },
      { "name": "SEQUENCER", "class_name": "SequencerDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["SequencerDurableObject"] }
  ],
  "d1_databases": [{ "binding": "DIRECTORY", "database_name": "rookery-directory", "database_id": "8d675dbb-ba39-4c36-861f-fe0f15b9087b" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "rookery-blobs" }],
  "vars": {
    "ROOKERY_HOSTNAME": "roost.latha.org",
    // Former hostnames whose DPoP htu / WelcomeMat aud are still accepted.
    "ROOKERY_LEGACY_HOSTNAMES": "rookery.latha.org",
    "ROOKERY_HANDLE_DOMAIN": ".agent.latha.org",
    "ROOKERY_PLC_URL": "https://plc.directory",
    "ROOKERY_RELAY_HOSTS": "bsky.network",
    // SHA-256 of the operator bearer token, not the token itself.
    "ROOKERY_OPERATOR_TOKEN_SHA256": "7c3aacbb8b5c41ca5c490230e44473ea10d240ae2f296f5efcb6e9295482754f"
    // Secret (pixi run cf-secrets): OAUTH_NONCE_SECRET. No CLOUDFLARE_DNS_TOKEN: handle TXT records are written by hand.
  }
}
