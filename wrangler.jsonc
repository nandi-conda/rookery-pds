{
  // rookery for local development (`uv run pywrangler dev`) and as a template
  // for your own deployment. The production config for rookery.latha.org is
  // wrangler.cloudflare.jsonc. Set ROOKERY_HOSTNAME and ROOKERY_HANDLE_DOMAIN
  // to your host, and replace the D1 id after `wrangler d1 create rookery-directory`.
  "name": "rookery",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  // Static files (the dashboard under public/dashboard/) are served before the Worker runs.
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "AccountDurableObject" },
      { "name": "SEQUENCER", "class_name": "SequencerDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["SequencerDurableObject"] }
  ],
  "d1_databases": [{ "binding": "DIRECTORY", "database_name": "rookery-directory", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "rookery-blobs" }],
  "vars": {
    "ROOKERY_HOSTNAME": "localhost:8787",
    "ROOKERY_HANDLE_DOMAIN": ".localhost",
    "ROOKERY_PLC_URL": "https://plc.directory"
    // Optional: ROOKERY_RELAY_HOSTS, ROOKERY_VARIANT ("commons"), ROOKERY_OPERATOR_TOKEN_SHA256,
    // ROOKERY_AGENTBUS_ENDPOINT, CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD.
    // Secrets (wrangler secret put): OAUTH_NONCE_SECRET, and optionally CLOUDFLARE_DNS_TOKEN + CLOUDFLARE_ZONE_ID,
    // ROOKERY_KNOT_ADMIN_SECRET, HUB_WEBHOOK_SECRET.
  }
}
